# Uses blinker example from symbiosis for breathing effect

[Unit]
Description=Breathing effect

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/usr/libexec/toh/blinker breathing
ExecStop=-/usr/libexec/toh/blinker off
